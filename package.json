{
  "name": "hive-legends",
  "version": "0.1.0",
  "private": true,
  "description": "Hive Legends — a cooperative arcade action RPG dungeon brawler.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:combat": "UPDATE_DOCS=1 vitest run tests/combatDoc.test.ts",
    "art:build": "UPDATE_ART=1 vitest run tests/artPack.test.ts",
    "lint": "eslint src tests e2e scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
